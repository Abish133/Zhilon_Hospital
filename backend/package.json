    "bwip-js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^3.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql": "^2.18.1",
    "mysql2": "^3.22.3",
    "node-cron": "^4.2.1",
