  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/scripts/migrate.js up",
    "migrate:up": "node src/scripts/migrate.js up",
    "migrate:down": "node src/scripts/migrate.js down",
    "migrate:down:all": "node src/scripts/migrate.js down:all",
    "migrate:status": "node src/scripts/migrate.js status",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "seed": "node src/scripts/seed.js",
    "reset:db": "node src/scripts/resetDatabase.js",
    "db:reset-and-seed": "node src/scripts/migrateAndSeed.js",
    "test": "node --test"
  },
