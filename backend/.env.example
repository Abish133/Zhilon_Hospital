# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hms_db
DB_USER=root
DB_PASS=yourpassword
DB_DIALECT=mysql

# ─── Connection Pool ─────────────────────────────────────────────────────────
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=10000

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=8h

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Keep in sync with APP_URL
# and the frontend dev port (VITE_PORT).
CORS_ORIGIN=http://localhost:3000

# ─── Frontend / App URL ──────────────────────────────────────────────────────
# Base URL of the frontend; used to build password-reset links in emails.
# Must match the port the frontend is served on (VITE_PORT, default 3000).
APP_URL=http://localhost:3000

# ─── Email / SMTP (platform fallback) ────────────────────────────────────────
# Multi-tenant: each hospital can set its OWN SMTP under Settings → Email (SMTP),
# stored per-hospital in the DB. These env values are the PLATFORM FALLBACK used
# only when a hospital hasn't configured its own. Leave SMTP_HOST blank to disable
# real sending entirely — reset links are then printed to the backend console
# (handy for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HMS <no-reply@hms.local>"

# ─── File Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
