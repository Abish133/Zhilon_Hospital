# ─── Dev server ──────────────────────────────────────────────────────────────
# Port the frontend dev server runs on. Keep in sync with the backend's APP_URL
# and CORS_ORIGIN so password-reset links and API calls resolve correctly.
VITE_PORT=3000

# ─── API ─────────────────────────────────────────────────────────────────────
# Backend API base URL (must include /api suffix)
VITE_API_BASE_URL=http://localhost:8000/api

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME=HMS
VITE_APP_VERSION=1.0.0
